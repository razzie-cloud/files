FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/files-dev-s3 ./cmd/files-dev-s3

FROM alpine:3.22
RUN addgroup -g 10001 files && adduser -D -u 10001 -G files files
COPY --from=build /out/files-dev-s3 /usr/local/bin/files-dev-s3
USER files
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/files-dev-s3"]
